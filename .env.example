# ── Database ────────────────────────────────────────────────────────────────
# Local dev (default): SQLite, zero setup.
DATABASE_URL="file:./dev.db"
#
# Production (Vercel): Postgres on Neon. Also set prisma/schema.prisma
#   datasource.provider = "postgresql"
# Use the *pooled* connection string ("-pooler" host) for the app:
# DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# And the *direct* (non-pooled) string for migrations:
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Independent secret used to derive per-user puzzle flags. Never expose to the client.
FLAG_SECRET=""

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Create a free database at https://console.upstash.com/redis
# When BOTH are empty the app uses an in-memory limiter (fine for local dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── App ─────────────────────────────────────────────────────────────────────
# The event slug the participant site serves: "demo-session" or "pseudo-breach-main"
NEXT_PUBLIC_ACTIVE_EVENT="demo-session"
