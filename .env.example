# ── Database ────────────────────────────────────────────────────────────────
# Postgres on Neon (schema.prisma datasource.provider = "postgresql").
#   DATABASE_URL = *pooled* connection ("-pooler" in the host) — used at runtime.
#   DIRECT_URL   = *direct* connection (no "-pooler")           — used by `prisma db push`.
# Both come from the Neon dashboard → Connection Details (toggle "Pooled connection").
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"
#
# Local SQLite instead? Set both to file:./dev.db and flip provider back to "sqlite":
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Independent secret used to derive per-user puzzle flags. Never expose to the client.
FLAG_SECRET=""

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Create a free database at https://console.upstash.com/redis
# When BOTH are empty the app uses an in-memory limiter (fine for local dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── App ─────────────────────────────────────────────────────────────────────
# The event slug the participant site serves: "demo-session" or "pseudo-breach-main"
NEXT_PUBLIC_ACTIVE_EVENT="demo-session"
