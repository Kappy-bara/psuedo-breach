// PSEUDO-BREACH — data model (v2: the hacking dungeon)
//
// Local dev uses SQLite (zero setup). Production on Vercel uses Postgres (Neon).
// To switch to Postgres: change `provider` below to "postgresql" and set DATABASE_URL
// to your Neon pooled connection string. The schema is written to be portable:
// no enums, no scalar lists, no native Json — JSON payloads are stored as String
// and parsed in app code (see src/lib/json.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id        String   @id @default(cuid())
  slug      String   @unique // "demo-session" | "pseudo-breach-main"
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    String   @default("draft") // draft | live | ended
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  users         User[]
  modules       Module[]
  announcements Announcement[]
  items         Item[]
  npcs          Npc[]
}

model User {
  id           String   @id @default(cuid())
  registerId   String   @unique
  passwordHash String
  displayName  String
  branch       String   @default("")
  year         String   @default("")
  role         String   @default("participant") // participant | admin
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  submissions Submission[]
  solves      Solve[]
  hintUnlocks HintUnlock[]
  inventory   InventoryEntry[]
  auditLogs   AuditLog[]       @relation("AuditActor")

  @@index([eventId, registerId])
}

model Module {
  id       String    @id @default(cuid())
  slug     String
  title    String
  blurb    String    @default("")
  order    Int       @default(0)
  theme    String    @default("default")
  unlockAt DateTime? // null = follows event start
  isHidden Boolean   @default(false)
  // JSON string: { itemKey: qty } the player must HOLD to enter. "{}" = open.
  prerequisiteItemsJson String @default("{}")
  // JSON string: { itemKey: qty } granted when every puzzle in the room is solved.
  clearRewardJson       String @default("{}")

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  puzzles Puzzle[]
  hints   Hint[]

  @@unique([eventId, slug])
  @@index([eventId, order])
}

model Puzzle {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  promptMd   String
  // static | regex | numeric | cminus-output
  type       String @default("static")
  basePoints Int    @default(100)
  difficulty String @default("easy") // easy | medium | hard | boss
  order      Int    @default(0)
  // JSON string. Shape depends on type — see src/lib/validators.ts
  //   static:  { "answer": "..."} or { "perUser": true }  (perUser => HMAC flag)
  //   regex:   { "pattern": "^FLAG\\{.*\\}$", "flags": "i" }
  //   numeric: { "value": 42, "tolerance": 0 }
  //   cminus-output: { "expectedStdout": "..." }
  //   optional on any: { "leakInSource": true }, { "domFlagB64": "..." }, { "wrongCostCreds": 5 }
  validatorConfig String  @default("{}")
  perUserFlag     Boolean @default(false)
  cooldownSec     Int     @default(15)
  isHidden        Boolean @default(false)
  // JSON string: { itemKey: qty } granted to the player on solve (loot).
  rewardsJson     String  @default("{}")

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  submissions Submission[]
  solves      Solve[]
  hints       Hint[]

  @@index([moduleId, order])
}

model Hint {
  id        String @id @default(cuid())
  contentMd String
  order     Int    @default(0)
  // JSON string, one of:
  //   { "kind": "free" }
  //   { "kind": "auto-after-wrong", "n": 3 }
  //   { "kind": "item", "key": "keycard-red" }   (hold this item)
  //   { "kind": "buy", "cost": 30 }              (inline "buy for N creds")
  //   { "kind": "npc" }                          (only via an NpcTrade with revealsHintId)
  unlockRule String @default("{\"kind\":\"free\"}")

  moduleId String
  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  puzzleId String?
  puzzle   Puzzle? @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  unlocks HintUnlock[]

  @@index([moduleId, order])
}

model HintUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintId     String
  hint       Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  costPaid   Int      @default(0) // creds spent, if bought
  unlockedAt DateTime @default(now())

  @@unique([userId, hintId])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId  String
  puzzle    Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  value     String
  isCorrect Boolean
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, puzzleId, createdAt])
  @@index([puzzleId, createdAt])
}

model Solve {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId       String
  puzzle         Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  basePts        Int
  bonusPts       Int
  solveIndex     Int // 0 = first blood
  timeToSolveSec Int
  solvedAt       DateTime @default(now())

  @@unique([userId, puzzleId])
  @@index([puzzleId, solveIndex])
}

// ── inventory / economy ──────────────────────────────────────────────────────

model Item {
  id            String  @id @default(cuid())
  key           String // "cred" | "keycard-red" | "frag-alpha" | "loot-old-badge" | ...
  name          String
  descriptionMd String  @default("")
  type          String // cred | fragment | keycard | loot | trophy
  icon          String  @default("📦")
  stackable     Boolean @default(false)
  sellValue     Int     @default(0) // creds SUDO pays on buy-back (0 = not sellable)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
}

model InventoryEntry {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey  String
  quantity Int    @default(0)

  @@unique([userId, itemKey])
  @@index([userId])
}

model Npc {
  id      String @id @default(cuid())
  slug    String // "sudo"
  name    String
  blurbMd String @default("")
  icon    String @default("🤖")

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  trades NpcTrade[]

  @@unique([eventId, slug])
}

model NpcTrade {
  id                   String  @id @default(cuid())
  order                Int     @default(0)
  label                String
  descriptionMd        String  @default("")
  giveJson        String  @default("{}") // { itemKey: qty } consumed
  getItemsJson    String  @default("{}") // { itemKey: qty } granted (a keycard-master here = "vault opened")
  revealsHintId   String? // executing this trade also reveals this hint
  repeatable      Boolean @default(false)
  showIfHoldsJson String  @default("{}") // { itemKey: qty } required to SEE the trade
  isHidden        Boolean @default(false)

  npcId String
  npc   Npc    @relation(fields: [npcId], references: [id], onDelete: Cascade)

  executions TradeExecution[]

  @@index([npcId, order])
}

model TradeExecution {
  id        String   @id @default(cuid())
  userId    String
  tradeId   String
  trade     NpcTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, tradeId])
}

// ── misc ─────────────────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  bodyMd    String
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  meta       String   @default("{}") // JSON string
  createdAt  DateTime @default(now())

  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}
